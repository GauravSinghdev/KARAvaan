# Required for PostgreSQL (Neon connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required to unlock /upload-a-blog. Use a long, unique password.
BLOG_PASSWORD="change-this-to-a-long-random-password"
# Required to sign secure editor sessions; generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Cloudinary credentials (server-side only)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
